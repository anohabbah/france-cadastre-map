{
  "name": "france-cadastre-map",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:geocode": "npx @openapitools/openapi-generator-cli generate -i src/lib/geocode/geocode.yaml -g typescript-angular -o src/lib/geocode --additional-properties=enumPropertyNaming=UPPERCASE,stringEnums=true,fileNaming=kebab-case"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.0.0-next.10",
    "@angular/common": "^21.0.0-next.0",
    "@angular/compiler": "^21.0.0-next.0",
    "@angular/core": "^21.0.0-next.0",
    "@angular/forms": "^21.0.0-next.0",
    "@angular/material": "21.0.0-next.10",
    "@angular/platform-browser": "^21.0.0-next.0",
    "@angular/router": "^21.0.0-next.0",
    "@maplibre/ngx-maplibre-gl": "^20.0.0",
    "maplibre-gl": "^5.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0-next.9",
    "@angular/cli": "^21.0.0-next.9",
    "@angular/compiler-cli": "^21.0.0-next.0",
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.0"
  }
}
